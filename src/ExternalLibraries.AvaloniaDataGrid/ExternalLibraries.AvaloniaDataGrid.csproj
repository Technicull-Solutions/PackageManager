<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <TargetFrameworks />
    <AssemblyName>Avalonia.Controls.DataGrid</AssemblyName>
    <RootNamespace>Avalonia.Controls</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>12.0.0</Version>
    <AssemblyVersion>12.0.0.0</AssemblyVersion>
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>Avalonia.public.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <AvaloniaXaml Include="Themes/**/*.xaml" />
  </ItemGroup>
</Project>
