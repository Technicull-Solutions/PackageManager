<UserControl x:Class="UniGetUI.Avalonia.Views.SidebarView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:vm="using:UniGetUI.Avalonia.ViewModels"
             xmlns:controls="using:UniGetUI.Avalonia.Views.Controls"
             xmlns:local="using:UniGetUI.Avalonia.Views"
             xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="SidebarRoot"
             x:DataType="vm:SidebarViewModel"
             MinWidth="64"
             Background="{DynamicResource SidebarBackground}"
             Foreground="{DynamicResource SidebarForeground}">

    <UserControl.Styles>
        <Style Selector="ListBoxItem.nav-item">
            <Setter Property="Foreground" Value="{DynamicResource SidebarForeground}"/>
        </Style>
        <Style Selector="ListBoxItem.nav-item:selected">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarForeground}"/>
        </Style>
        <Style Selector="ListBoxItem.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarHoverBackground}"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="SidebarLayout" RowDefinitions="*,Auto">

        <!-- Main nav items -->
        <ListBox x:Name="NavListBox"
                 Grid.Row="0"
                 SelectionMode="Single"
                 KeyboardNavigation.TabNavigation="Continue"
                 SelectionChanged="NavListBox_SelectionChanged"
                 Background="Transparent"
                 BorderThickness="0"
                 automation:AutomationProperties.AccessibilityView="Control"
                 automation:AutomationProperties.Name="{t:Translate Navigation}"
                 Padding="8,10,8,0">

            <ListBoxItem x:Name="CatalogNavBtn" Tag="Catalog" Classes="nav-item" Padding="4,2" CornerRadius="6"
                         IsVisible="True"
                         automation:AutomationProperties.Name="{t:Translate Apps}"
                         automation:AutomationProperties.AcceleratorKey="Ctrl+1"
                         ToolTip.Tip="{t:Translate Apps}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                    <controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/catalog.svg"
                                      Width="24" Height="24" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SidebarForeground}"/>
                    <TextBlock Grid.Column="1" Text="{t:Translate Apps}" FontSize="14"
                               VerticalAlignment="Center"
                               IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                </Grid>
            </ListBoxItem>

            <!-- Search configured sources -->
            <ListBoxItem x:Name="DiscoverNavBtn" Tag="Discover" Classes="nav-item" Padding="4,2" CornerRadius="6"
                         automation:AutomationProperties.Name="{t:Translate Search apps}"
                         automation:AutomationProperties.AcceleratorKey="Ctrl+5"
                         ToolTip.Tip="{t:Translate Search apps}">
                <Panel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                        <controls:SvgIcon Grid.Column="0" Path="avares://UniGetUI/Assets/Symbols/DiscoverPackage.svg" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource SidebarForeground}" />
                        <TextBlock Grid.Column="1" Text="{t:Translate Search apps}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                    </Grid>
                    <ProgressBar IsIndeterminate="{Binding DiscoverIsLoading}"
                                 IsVisible="{Binding DiscoverIsLoading}"
                                 Height="2"
                                 Width="32"
                                 MinWidth="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Margin="4,0,0,2"/>
                </Panel>
            </ListBoxItem>

            <!-- Software Updates -->
            <ListBoxItem x:Name="UpdatesNavBtn" Tag="Updates" Classes="nav-item" Padding="4,2" CornerRadius="6"
                         automation:AutomationProperties.Name="{t:Translate Updates}"
                         automation:AutomationProperties.AcceleratorKey="Ctrl+2"
                         ToolTip.Tip="{t:Translate Updates}">
                <Panel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                        <controls:SvgIcon Grid.Column="0" Path="avares://UniGetUI/Assets/Symbols/update.svg" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource SidebarForeground}"/>
                        <TextBlock Grid.Column="1" Text="{t:Translate Updates}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                    </Grid>
                    <!-- Update count bubble (InfoBadge-style), anchored to the icon's top-right in both rail and flyout -->
                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="3,1"
                            MinWidth="16"
                            Height="16"
                            IsVisible="{Binding UpdatesBadgeVisible}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="26,5,-20,0">
                        <TextBlock Text="{Binding UpdatesBadgeText}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ProgressBar IsIndeterminate="{Binding UpdatesIsLoading}"
                                 IsVisible="{Binding UpdatesIsLoading}"
                                 Height="2"
                                 Width="32"
                                 MinWidth="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Margin="4,0,0,2"/>
                </Panel>
            </ListBoxItem>

            <!-- Installed Packages -->
            <ListBoxItem x:Name="InstalledNavBtn" Tag="Installed" Classes="nav-item" Padding="4,2" CornerRadius="6"
                         automation:AutomationProperties.Name="{t:Translate Installed}"
                         automation:AutomationProperties.AcceleratorKey="Ctrl+3"
                         ToolTip.Tip="{t:Translate Installed}">
                <Panel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                        <controls:SvgIcon Grid.Column="0" Path="avares://UniGetUI/Assets/Symbols/InstalledPackages.svg" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource SidebarForeground}"/>
                        <TextBlock Grid.Column="1" Text="{t:Translate Installed}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                    </Grid>
                    <ProgressBar IsIndeterminate="{Binding InstalledIsLoading}"
                                 IsVisible="{Binding InstalledIsLoading}"
                                 Height="2"
                                 Width="32"
                                 MinWidth="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Margin="4,0,0,2"/>
                </Panel>
            </ListBoxItem>

            <!-- Employee-visible activity history -->
            <ListBoxItem x:Name="BundlesNavBtn" Tag="OperationHistory" Classes="nav-item" Padding="4,2" CornerRadius="6"
                         automation:AutomationProperties.Name="{t:Translate Activity}"
                         automation:AutomationProperties.AcceleratorKey="Ctrl+4"
                         ToolTip.Tip="{t:Translate Activity}">
                <Panel>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                        <controls:SvgIcon Grid.Column="0" Path="avares://UniGetUI/Assets/Symbols/history.svg" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource SidebarForeground}"/>
                        <TextBlock Grid.Column="1" Text="{t:Translate Activity}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                    </Grid>
                </Panel>
            </ListBoxItem>

            <ListBoxItem x:Name="CatalogEditorNavBtn" Tag="CatalogEditor" Classes="nav-item" Padding="4,2" CornerRadius="6"
                        IsVisible="False"
                        automation:AutomationProperties.Name="{t:Translate Catalog Editor}"
                        ToolTip.Tip="{t:Translate Catalog Editor}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                    <controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/add_to.svg"
                                      Width="24" Height="24" VerticalAlignment="Center"
                                      Foreground="{DynamicResource SidebarForeground}"/>
                    <TextBlock Grid.Column="1" Text="{t:Translate Catalog Editor}" FontSize="14"
                               VerticalAlignment="Center"
                               IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                </Grid>
            </ListBoxItem>

        </ListBox>

        <!-- Footer items -->
        <StackPanel Grid.Row="1" Margin="8,0,8,12" Spacing="2">
            <controls:UserAvatarControl IsVisible="False" HorizontalAlignment="Left" Margin="8,4,0,4"/>

            <!-- Settings & Package Managers are nav targets too, so they live in their own ListBox
                 (selection coordinated with the main one in code-behind) and share the nav-item look. -->
            <ListBox x:Name="FooterNavListBox"
                     SelectionMode="Single"
                     KeyboardNavigation.TabNavigation="Continue"
                     SelectionChanged="FooterNavListBox_SelectionChanged"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">

                <!-- Settings -->
                <ListBoxItem x:Name="SettingsNavBtn" Tag="Settings" Classes="nav-item" Padding="4,2" CornerRadius="6"
                             Tapped="SettingsNavBtn_Tapped"
                             automation:AutomationProperties.Name="{t:Translate Settings}"
                             automation:AutomationProperties.AcceleratorKey="Ctrl+5"
                             ToolTip.Tip="{t:Translate Settings}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                        <controls:SvgIcon Grid.Column="0" x:Name="SettingsIcon" Path="avares://UniGetUI/Assets/Symbols/settings.svg" Width="24" Height="24" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" Foreground="{DynamicResource SidebarForeground}"/>
                        <TextBlock Grid.Column="1" Text="{t:Translate Settings}" FontSize="14" VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                    </Grid>
                </ListBoxItem>

                <!-- Retained as a named compatibility target while manager configuration moves to
                     administrator-owned Group Policy / JSON. It is never shown to end users. -->
                <ListBoxItem x:Name="ManagersNavBtn" Tag="Managers" Classes="nav-item" Padding="4,2" CornerRadius="6"
                             automation:AutomationProperties.Name="{t:Translate Package Managers}"
                             automation:AutomationProperties.AcceleratorKey="Ctrl+6"
                             ToolTip.Tip="{t:Translate Package Managers}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                        <controls:SvgIcon Grid.Column="0" Path="avares://UniGetUI/Assets/Symbols/package_managers.svg" Width="24" Height="24" VerticalAlignment="Center" Foreground="{DynamicResource SidebarForeground}"/>
                        <TextBlock Grid.Column="1" Text="{t:Translate Package Managers}" FontSize="14" VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                    </Grid>
                </ListBoxItem>

                <!-- More is kept selected while its flyout is open so its navigation pill remains visible. -->
                <ListBoxItem x:Name="MoreNavBtn" Tag="More" Classes="nav-item" Padding="4,2" CornerRadius="6"
                             automation:AutomationProperties.Name="{t:Translate More}"
                             automation:AutomationProperties.AcceleratorKey="Ctrl+7"
                             ToolTip.Tip="{t:Translate More}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="8,8">
                        <TextBlock Grid.Column="0" Text="···" FontSize="20" Width="24" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   automation:AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock Grid.Column="1" Text="{t:Translate More}" FontSize="14" VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                    </Grid>
                    <FlyoutBase.AttachedFlyout>
                        <MenuFlyout Placement="RightEdgeAlignedTop">
                        <MenuItem Header="{t:Translate Application log}" Command="{Binding RequestNavigationCommand}" CommandParameter="OwnLog">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/buggy.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{t:Translate Package Manager logs}" Command="{Binding RequestNavigationCommand}" CommandParameter="ManagerLog">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/console.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{Binding VersionLabel}" IsEnabled="False">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/info_round.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{t:Translate Release notes}" Command="{Binding RequestNavigationCommand}" CommandParameter="ReleaseNotes">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/megaphone.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{t:Translate Check for updates}" Command="{Binding CheckForUpdatesCommand}">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/update.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{t:Translate Help}" Command="{Binding RequestNavigationCommand}" CommandParameter="Help">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/help.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{t:Translate About}" Command="{Binding RequestNavigationCommand}" CommandParameter="About">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/info_round.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{t:Translate Quit Evergreen Endpoint | APPS}" Command="{Binding RequestNavigationCommand}" CommandParameter="Quit">
                            <MenuItem.Icon><controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/close_round.svg" Width="16" Height="16"/></MenuItem.Icon>
                        </MenuItem>
                        </MenuFlyout>
                    </FlyoutBase.AttachedFlyout>
                </ListBoxItem>

            </ListBox>

            <Grid Margin="0,8,0,0"
                  ColumnDefinitions="48,*"
                  RowDefinitions="Auto,Auto"
                  HorizontalAlignment="Stretch"
                  automation:AutomationProperties.Name="{Binding BuildStatusText}">
                <ToolTip.Tip>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding BuildStatusText}"/>
                        <TextBlock Text="{Binding VersionLabel}"/>
                    </StackPanel>
                </ToolTip.Tip>
                <Panel Grid.RowSpan="2"
                       Width="12" Height="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource BuildStatusCurrentBrush}" IsVisible="{Binding BuildStatusIsCurrent}"/>
                    <Ellipse Fill="{DynamicResource BuildStatusSlightlyBehindBrush}" IsVisible="{Binding BuildStatusIsSlightlyBehind}"/>
                    <Ellipse Fill="{DynamicResource BuildStatusBehindBrush}" IsVisible="{Binding BuildStatusIsBehind}"/>
                    <Ellipse Fill="{DynamicResource BuildStatusCriticalBrush}" IsVisible="{Binding BuildStatusIsCriticallyBehind}"/>
                </Panel>
                <TextBlock Grid.Column="1"
                           Text="{Binding BuildStatusText}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding VersionLabel}"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource SidebarSecondaryForeground}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding $parent[local:SidebarView].ShowLabels}"
                           automation:AutomationProperties.Name="{Binding VersionLabel}"/>
            </Grid>

        </StackPanel>

        <!-- One shared indicator moves between items so selection changes use WinUI's
             leading/trailing-edge stretch instead of fading separate item indicators. -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <!-- Fixed-radius caps preserve the original pill silhouette while the rectangular
                 stem stretches between them using render transforms only. -->
            <Panel x:Name="NavigationSelectionPill"
                   Width="3" Height="16"
                   IsVisible="False">
                <Ellipse x:Name="NavigationPillTopCap"
                         Width="3" Height="3"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         RenderTransformOrigin="0%,0%"
                         Fill="{DynamicResource BrandOrangeBrush}"/>
                <Border x:Name="NavigationPillStem"
                        Width="3" Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        RenderTransformOrigin="0%,0%"
                        Background="{DynamicResource BrandOrangeBrush}"/>
                <Ellipse x:Name="NavigationPillBottomCap"
                         Width="3" Height="3"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         RenderTransformOrigin="0%,0%"
                         Fill="{DynamicResource BrandOrangeBrush}"/>
            </Panel>
        </Canvas>
    </Grid>
</UserControl>
