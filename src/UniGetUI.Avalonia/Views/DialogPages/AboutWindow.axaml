<dialogs:ImmersiveDialog xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:UniGetUI.Avalonia.Views.DialogPages"
        xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
        xmlns:about="using:UniGetUI.Avalonia.Views.Pages.AboutPages"
        x:Class="UniGetUI.Avalonia.Views.DialogPages.AboutWindow"
        Title="{t:Translate About Evergreen Endpoint | APPS}"
        MaxWidth="980"
        MinWidth="760"
        MaxHeight="860"
        MinHeight="600"
        Background="{DynamicResource AboutDialogBodyBackground}">

    <TabControl x:Name="MainTabControl"
                Padding="0"
                Background="{DynamicResource AboutDialogHeaderBackground}"
                Foreground="{DynamicResource AboutDialogHeaderForeground}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
        <TabControl.Styles>
            <Style Selector="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource AboutDialogHeaderForeground}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Grid Background="Transparent">
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Border x:Name="SelectionIndicator"
                                        Height="4"
                                        HorizontalAlignment="Stretch"
                                        Background="{DynamicResource BrandOrangeBrush}"
                                        IsVisible="False"/>
                            </StackPanel>
                        </Grid>
                    </ControlTemplate>
                </Setter>
            </Style>
            <Style Selector="TabItem:pointerover, TabItem:pressed, TabItem:selected">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource AboutDialogHeaderForeground}"/>
            </Style>
            <Style Selector="TabItem:selected /template/ Border#SelectionIndicator">
                <Setter Property="IsVisible" Value="True"/>
            </Style>
        </TabControl.Styles>
        <TabControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
        </TabControl.ItemsPanel>

        <TabItem Header="{t:Translate About}"
                 FontSize="20"
                 Padding="24,12,24,8">
            <about:AboutPage/>
        </TabItem>

        <TabItem Header="{t:Translate Third-party licenses}"
                 FontSize="20"
                 Padding="24,12,24,8">
            <about:ThirdPartyLicenses/>
        </TabItem>

        <TabItem Header="{t:Translate Contributors}"
                 FontSize="20"
                 Padding="24,12,24,8">
            <about:Contributors/>
        </TabItem>
    </TabControl>

</dialogs:ImmersiveDialog>
