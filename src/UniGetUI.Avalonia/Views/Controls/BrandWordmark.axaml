<UserControl x:Class="UniGetUI.Avalonia.Views.Controls.BrandWordmark"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Panel>
        <Image x:Name="LightWordmark"
               Source="avares://UniGetUI/Assets/Brand/EEA-Logo-Text_Light@2x.png"
               Stretch="Uniform"/>
        <Image x:Name="DarkWordmark"
               Source="avares://UniGetUI/Assets/Brand/EEA-Logo-Text_Light-Alternate@2x.png"
               Stretch="Uniform"/>
    </Panel>
</UserControl>
