<UserControl x:Class="UniGetUI.Avalonia.Views.Pages.SettingsPages.SourceManagerCard"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:vm="using:UniGetUI.Avalonia.ViewModels.Pages.SettingsPages"
             xmlns:interfaces="using:UniGetUI.PackageEngine.Interfaces"
             xmlns:controls="using:UniGetUI.Avalonia.Views.Controls"
             xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:DataType="vm:SourceManagerCardViewModel">

    <Border Classes="settings-card"
            CornerRadius="8"
            BorderThickness="1"
            Padding="16,12">
    <StackPanel Orientation="Vertical" Spacing="8">

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding TitleText}"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       FontSize="15"/>
            <Button Grid.Column="1"
                    Command="{Binding ReloadSourcesCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    Padding="6"
                    ToolTip.Tip="{t:Translate Reload sources}"
                    automation:AutomationProperties.Name="{t:Translate Reload sources}">
                <controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/reload.svg"
                                  Width="16" Height="16"
                                  Foreground="{DynamicResource TextControlForeground}"/>
            </Button>
        </Grid>

        <TextBlock Text="{Binding ManagedNotice}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- Loading indicator -->
        <ProgressBar IsIndeterminate="{Binding IsLoading}"
                     IsVisible="{Binding IsLoading}"
                     Height="4"/>

        <!-- Source list: border always visible even when empty -->
        <Border BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                MinHeight="60"
                Padding="4">
            <ItemsControl ItemsSource="{Binding Sources}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="interfaces:IManagerSource">
                    <Grid ColumnDefinitions="4,Auto,*"
                          Margin="0,2"
                          MinHeight="32">
                        <!-- Accent bar -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="2"
                                Margin="0,4"/>
                        <!-- Package icon + name -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="10,0,4,0"
                                    VerticalAlignment="Center">
                            <controls:SvgIcon Path="avares://UniGetUI/Assets/Symbols/package.svg"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextControlForeground}"/>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       MinWidth="120"/>
                        </StackPanel>
                        <!-- URL -->
                        <SelectableTextBlock Grid.Column="2"
                                   Text="{Binding Url}"
                                   VerticalAlignment="Center"
                                   Classes="hyperlink"
                                   FontSize="14"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0"/>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
    </Border>
</UserControl>
