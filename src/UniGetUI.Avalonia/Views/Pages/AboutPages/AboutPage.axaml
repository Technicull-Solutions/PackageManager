<UserControl x:Class="UniGetUI.Avalonia.Views.Pages.AboutPages.AboutPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:Avalonia.Automation;assembly=Avalonia.Controls"
             xmlns:vm="using:UniGetUI.Avalonia.ViewModels.Pages.AboutPages"
             xmlns:controls="using:UniGetUI.Avalonia.Views.Controls"
             xmlns:t="using:UniGetUI.Avalonia.MarkupExtensions"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:DataType="vm:AboutPageViewModel">

    <UserControl.Styles>
        <Style Selector="Button.about-link:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.about-link:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.about-link:pointerover TextBlock.hyperlink,
                         Button.about-link:pressed TextBlock.hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource BrandOrangeBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource AboutDialogBodyBackground}">
        <StackPanel Orientation="Vertical"
                    Spacing="8"
                    Margin="46,34,46,38">
            <TextBlock Text="{Binding PublisherText}"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AboutDialogBodyForeground}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding ProductDescription}"
                       FontSize="18"
                       LineHeight="26"
                       Foreground="{DynamicResource AboutDialogBodyForeground}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <SelectableTextBlock Text="{Binding VersionText}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AboutDialogBodyForeground}"
                                 Margin="0,0,0,0"/>
            <SelectableTextBlock Text="{Binding UpstreamBaseText}"
                                 FontSize="16"
                                 Foreground="{DynamicResource AboutDialogBodyForeground}"
                                 Margin="0,0,0,24"/>

            <!-- Disclaimer banner -->
            <Border CornerRadius="8"
                    Padding="24,16"
                    Margin="0,0,0,24"
                    Background="{DynamicResource AboutDisclaimerBackground}"
                    BorderBrush="{DynamicResource AboutDisclaimerBorderBrush}"
                    BorderThickness="2">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Warning icon -->
                    <Border Grid.Column="0"
                            Width="38" Height="38"
                            CornerRadius="19"
                            Background="{DynamicResource AboutDisclaimerIconBackground}"
                            VerticalAlignment="Top"
                            Margin="0,0,16,0">
                        <TextBlock Text="!"
                                   Foreground="{DynamicResource AboutDisclaimerIconForeground}"
                                   FontWeight="Bold"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Text -->
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{Binding DisclaimerTitle}"
                                   FontSize="17"
                                   Foreground="{DynamicResource AboutDisclaimerForeground}"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding DisclaimerMessage}"
                                   FontSize="16"
                                   LineHeight="22"
                                   Foreground="{DynamicResource AboutDisclaimerForeground}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{t:Translate Useful links}"
                       FontFamily="Segoe UI Variable Display"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AboutDialogBodyForeground}"
                       Margin="0,0,0,6"/>

            <Button Command="{Binding OpenHomepageCommand}"
                    Classes="about-link"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    automation:AutomationProperties.Name="{t:Translate Evergreen Endpoint | APPS Homepage}">
                <TextBlock Classes="hyperlink"
                           FontSize="16"
                           Text="{t:Translate Evergreen Endpoint | APPS Homepage}"
                           automation:AutomationProperties.AccessibilityView="Raw"/>
            </Button>

            <Button Command="{Binding OpenIssuesCommand}"
                    Classes="about-link"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    automation:AutomationProperties.Name="{t:Translate Report an issue or submit a feature request}">
                <TextBlock Classes="hyperlink"
                           FontSize="16"
                           Text="{t:Translate Report an issue or submit a feature request}"
                           automation:AutomationProperties.AccessibilityView="Raw"/>
            </Button>

            <Button Command="{Binding OpenRepositoryCommand}"
                    Classes="about-link"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalAlignment="Center"
                    automation:AutomationProperties.Name="{t:Translate Evergreen Endpoint Package Manager Repository}">
                <TextBlock Classes="hyperlink"
                           FontSize="16"
                           Text="{t:Translate Evergreen Endpoint Package Manager Repository}"
                           automation:AutomationProperties.AccessibilityView="Raw"/>
            </Button>

        </StackPanel>
    </ScrollViewer>

</UserControl>
